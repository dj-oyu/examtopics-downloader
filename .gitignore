# original upstream rules
examtopics_output.md
examtopics_output.html
examtopics_output.pdf
*.txt
env/
!examples/*
.DS_STORE

# === scraped exam data — NOT redistributable (legal risk) ===
*.db
*.db-journal
*.db-wal
*.db-shm
/*.md
!/README.md
!/AGENTS.md

# === build / deps ===
node_modules/
bun.lockb

# === editor / OS ===
.claude/
.vscode/
.idea/
GEMINI.md

# === agent config: ignore everything under .gemini/ except whitelisted skills.
# Pattern uses /* + re-include to bypass git's "cannot re-include if parent
# directory is excluded" limitation that breaks plain `!.gemini/skills/foo.md`.
.gemini/*
!.gemini/skills/
.gemini/skills/*
!.gemini/skills/exam-translator.md

# === secrets: ignore all .env* variants, allow only the schema example ===
.env*
!.env.example

# === local workflow intermediates (one-shot scripts and JSON payloads) ===
# JSON at repo root is treated as scraped/translation data (legal risk)
/*.json
# Loose Python helper scripts at repo root (workflow scratch). Real tooling lives in tools/
/apply_translations*.py
/bulk_save_final.py
/fetch_*.py
/inspect_questions.py
/split_batches.py

# transient tooling work
/tools/_work/

# runtime agent invocation logs (web/src/agent.ts → logs/agent.jsonl)
/logs/
