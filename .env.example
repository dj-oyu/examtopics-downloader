# Copy to .env (gitignored) and fill in your values.
# Load before scraping:  set -a; source .env; set +a
#
# Then run e.g.:  go run ./cmd/main.go -p amazon -s soa-c03 -c -t "$GH_PAT" -o soa-c03.md

# GitHub fine-grained PAT.
# Required scope: Public Repositories (read-only). NO additional scopes.
# Lifts the GitHub API rate limit 60/h -> 5000/h so the cache-path scrape
# (thatonecodes/examtopics-data) can actually complete on a real exam.
GH_PAT=ghp_replace_me_with_your_fine_grained_pat
